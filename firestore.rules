rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /access_tokens/{tokenId} {
      allow read, write: if true;
    }
    match /device_trials/{deviceId} {
      allow read, write: if true;
    }
    match /channel_stats/{channelId} {
      allow read, write: if true;
    }
    match /channel_likes/{likeId} {
      allow read, write: if true;
    }
    match /channel_comments/{commentId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
