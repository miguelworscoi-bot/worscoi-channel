rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /access_tokens/{tokenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /device_trials/{deviceId} {
      allow read, write: if true;
    }
  }
}
