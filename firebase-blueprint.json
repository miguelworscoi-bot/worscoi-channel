{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Session type: normal user or administrator"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "basico", "vip", "premium", "anual"],
          "description": "Active subscription plan"
        },
        "planName": { "type": "string" },
        "planExpiresAt": { "type": "string" },
        "activatedToken": { "type": "string" },
        "favorites": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "email", "createdAt"]
    },
    "access_tokens": {
      "title": "Access Tokens",
      "description": "5-character generated access tokens for subscription plans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "description": "5-character alphanumeric token" },
        "plan": { "type": "string", "enum": ["basico", "vip", "premium", "anual"] },
        "planName": { "type": "string" },
        "durationDays": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "used", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "usedAt": { "type": "string" },
        "usedByUserId": { "type": "string" },
        "usedByEmail": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["code", "plan", "status", "createdAt"]
    },
    "device_trials": {
      "title": "Device Trials",
      "description": "Enforces one-time free trial per hardware/browser device fingerprint",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "claimedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "claimedEmail": { "type": "string" },
        "claimedUserId": { "type": "string" }
      },
      "required": ["deviceId", "claimedAt", "expiresAt"]
    },
    "channel_stats": {
      "title": "Channel Interaction Stats",
      "description": "Real-time count of adoros (likes) and comments for each channel",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "adorosCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "adorosCount", "commentsCount"]
    },
    "channel_likes": {
      "title": "Channel Adoros (Likes)",
      "description": "Individual adoro reaction record per user and channel",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "userId", "createdAt"]
    },
    "channel_comments": {
      "title": "Channel Comments",
      "description": "Real-time live user comments per channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "channelName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "userPlan": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "userId", "userName", "text", "createdAt"]
    }
  },
  "rules": {
    "users": {
      "read": "auth != null",
      "write": "auth != null && auth.uid == resource.id"
    },
    "device_trials": {
      "read": "true",
      "write": "true"
    },
    "channel_stats": {
      "read": "true",
      "write": "true"
    },
    "channel_likes": {
      "read": "true",
      "write": "true"
    },
    "channel_comments": {
      "read": "true",
      "write": "true"
    }
  }
}
