{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Session type: normal user or administrator"
        },
        "favorites": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "email", "createdAt"]
    }
  },
  "rules": {
    "users": {
      "read": "auth != null",
      "write": "auth != null && auth.uid == resource.id"
    }
  }
}
